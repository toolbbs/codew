# codew example environment file.
# Reference only; deploy/install.sh generates $APP_DIR/.env (default /opt/codew/.env).

CODEW_PANEL_PORT=2053
CODEW_PANEL_HOST=0.0.0.0
CODEW_UPDATE_MANIFEST_URL=https://raw.githubusercontent.com/toolbbs/codew/main/version.json

# Generate fresh values in production.
CODEW_ADMIN_USER=admin
CODEW_ADMIN_PASSWORD=change-me
CODEW_API_TOKEN=change-me
